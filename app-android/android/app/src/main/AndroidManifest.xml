<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/regras_de_extracao"
        android:fullBackupContent="@xml/regras_de_backup"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Retorno do login e do logout do Cognito: <applicationId>://auth. O esquema e o id de cada sabor (dev leva .dev),
                 para o retorno de um ambiente nunca cair no app do outro. Quem confere o endereco e o state e web/js/sessao.js. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${applicationId}" android:host="auth" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Push (item 54, fase 4): o servico que o SDK do Firebase Messaging exige; nao e aberto a outros apps. -->
        <service
            android:name=".FinancasMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- O canal em que o servidor pede para a notificacao aparecer (PushPlugin.CANAL_AVISOS). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="avisos" />
    </application>

    <!-- Android 11 ou mais esconde os outros pacotes do app: o PushPlugin confere se os Google Play Services existem. -->
    <queries>
        <package android:name="com.google.android.gms" />
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13 ou mais pede esta permissao em tempo de uso; antes dele ela ja vale. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
